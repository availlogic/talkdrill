{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "This config was generated for TalkDrill",
  "testRunner": "vitest",
  "reporters": ["progress", "clear-text", "html"],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "mutate": [
    "src/utils/zhengMath.ts",
    "src/services/drillCounterService.ts",
    "src/services/corpusService.ts",
    "src/utils/themeManager.ts",
    "src/services/translationService.ts",
    "src/utils/urlHelper.ts",
    "src/utils/textAlignment.ts",
    "src/utils/speechHelper.ts",
    "src/services/dictionaryService.ts",
    "src/hooks/useWordLookup.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 85,
    "break": 85
  }
}
